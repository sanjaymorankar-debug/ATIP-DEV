# ATIP container environment (W38, OPS-04). Copy to deploy/atip.env (git-ignored) and fill in.
# Secrets can instead be files in the atip_data volume: atip_data/secrets/<NAME> (ops/secrets.py).

# ── Environment ──────────────────────────────────────────────────────────
ATIP_ENV=production
# Inside the container ATIP listens on 0.0.0.0; docker-compose publishes it on the host's 127.0.0.1.
ATIP_DASHBOARD_HOST=0.0.0.0

# ── Broker / data (read by ops/secrets.py; never put these in config.json) ──
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
KITE_API_KEY=
KITE_API_SECRET=
ALPHA_VANTAGE_KEY=

# ── Alerts ───────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI (news classification, assistant) ──────────────────────────────────
ANTHROPIC_API_KEY=

# ── Encryption of stored secrets / vault (python -m ops keygen prints one) ─
ATIP_ENCRYPTION_KEY=

# ── PostgreSQL (the hosted deployment's database; replaced MySQL on 2026-10-09) ──
# Takes effect only together with config.json "database": {"backend": "postgresql",
# "allow_experimental": true}. "postgres" is the compose service name (docker compose
# --profile postgres); the password is the one in deploy/pg_password.txt.
# Existing SQLite data: migrate a COPY first with tools/sqlite_to_postgres.py.
# See docs/HOSTED_DEPLOYMENT.md.
# ATIP_DATABASE_URL=postgresql://atip:<password>@postgres:5432/atip
