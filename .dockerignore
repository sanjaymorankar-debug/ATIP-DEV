# Never bake state or secrets into the image: atip_data is a volume
atip_data/
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
*.log
.git/
.github/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
docs/*.xlsx
deploy/backups/
# W39b: local tooling state (agent worktrees, editor settings, caches) -- never in the image
.claude/
.idea/
.vscode/
node_modules/
.mypy_cache/
.ruff_cache/
