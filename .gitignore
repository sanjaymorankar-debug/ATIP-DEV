# ── ATIP ──────────────────────────────────────────────────────
# Runtime data: the live SQLite database, logs, cached downloads and
# dashboard state. Machine-specific and far too large for git.
atip_data/

# Secrets - never commit these.
.env
atip_data/config.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# W38 OPS-04: filled-in container env and the PostgreSQL password (deploy/atip.env.example is the template)
deploy/atip.env
deploy/pg_password.txt
# MySQL passwords from the removed docker compose --profile mysql (PostgreSQL replaced it,
# 2026-10-09); still ignored so a leftover secret file on a server is never committed
deploy/mysql_password.txt
deploy/mysql_root_password.txt

