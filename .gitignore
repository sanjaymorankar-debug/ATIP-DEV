# ── ATIP ──────────────────────────────────────────────────────
# Runtime data: the live SQLite database, logs, cached downloads and
# dashboard state. Machine-specific and far too large for git.
atip_data/
# setup_atip.sh migrate keeps a folder's previous atip_data/ aside under this name
atip_data.before-migrate-*/

# A view-only web server: what the Mac's push_viewer.sh sends (docs/VIEWER_SERVER.md)
viewer_incoming/

# Secrets - never commit these.
.env
atip_data/config.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# W38 OPS-04: filled-in container env and the PostgreSQL password (deploy/atip.env.example is the template)
deploy/atip.env
deploy/pg_password.txt
# MySQL passwords for the hosted deployment's docker compose --profile mysql
deploy/mysql_password.txt
deploy/mysql_root_password.txt

# W39b: temporary git worktrees made by agent tooling (each is a full checkout)
.claude/worktrees/
