{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atip/widgets/alerts_panel.json",
  "title": "Alerts and job health",
  "description": "Pipeline problems and recent alerts. Endpoint: GET /api/alerts.",
  "type": "object",
  "properties": {
    "job_health": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "alerts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "telegram_sent": {
            "type": [
              "number",
              "null"
            ]
          },
          "telegram_error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "required": [
    "alerts",
    "job_health"
  ]
}
