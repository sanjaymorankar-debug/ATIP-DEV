<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 22 Nov 2026: the 09:00 IST pre-open checklist notification (PreOpenReceiver). An inexact alarm window, so
         no SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM; set again after a reboot. Android 13+ asks to notify once. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.ATIP"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <!-- adjustResize: the keyboard shrinks the page (the order ticket's bottom sheet stays above it); uiMode is
             handled in MainActivity, so switching light / dark does not reload the page on screen -->
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The pre-open alarm (explicit intents from the app's own PendingIntents) and the system broadcasts after
             which the alarm is set again; not exported: only the system and the app itself reach it. -->
        <receiver android:name=".PreOpenReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
